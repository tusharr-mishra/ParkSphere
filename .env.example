# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB Atlas Cloud Cluster URI
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.lbkloqs.mongodb.net/ParkSphere?retryWrites=true&w=majority
# Localhost Fallback URI
MONGO_URI=mongodb://127.0.0.1:27017/parksphere

# Session & Security Keys
SESSION_SECRET=parksphere_session_secret_key_super_secure_9876
JWT_SECRET=parksphere_jwt_token_secret_key_32chars

# Nodemailer / Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password

# Cloudinary Media Storage (folder: ParkSphere_DEV)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mapbox Public Geospatial Token
MAPBOX_TOKEN=your_mapbox_token
