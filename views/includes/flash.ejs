<% if (typeof success !== 'undefined' && success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="background-color: #ecfdf5; border-color: #a7f3d0; color: #065f46; border-radius: 10px;">
    <i class="fa-solid fa-circle-check me-2 text-success"></i>
    <strong>Success:</strong> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="background-color: #fef2f2; border-color: #fecaca; color: #991b1b; border-radius: 10px;">
    <i class="fa-solid fa-triangle-exclamation me-2 text-danger"></i>
    <strong>Error:</strong> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof info !== 'undefined' && info && info.length) { %>
  <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert" style="background-color: #eff6ff; border-color: #bfdbfe; color: #1e40af; border-radius: 10px;">
    <i class="fa-solid fa-circle-info me-2 text-primary"></i>
    <%= info %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
