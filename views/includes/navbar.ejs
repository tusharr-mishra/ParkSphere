<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid">

    <!-- Brand Logo & Name (ParkSphere written big in Georgia) -->
    <a class="navbar-brand" href="/parking" aria-label="ParkSphere Home">
      <i class="fa-solid fa-square-parking brand-icon"></i>
      <span class="brand-name">ParkSphere</span>
    </a>

    <!-- Mobile Toggle Button -->
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
      data-bs-target="#navbarMainCollapse" aria-controls="navbarMainCollapse" aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navbar Content -->
    <div class="collapse navbar-collapse" id="navbarMainCollapse">

      <!-- Center Search Bar (ParkSphere 3-Segment Capsule) -->
      <form class="navbar-search-pill mx-md-auto my-2 my-md-0" action="/parking" method="GET" role="search"
        aria-label="Search parking facilities by city">
        <span class="search-segment-btn d-none d-lg-inline">Any City</span>
        <span class="search-divider d-none d-lg-inline"></span>
        <span class="search-segment-btn d-none d-lg-inline">Any Bay</span>
        <span class="search-divider d-none d-lg-inline"></span>
        <div class="search-input-wrap">
          <input type="text" name="city" class="search-input" placeholder="Search facilities or city..."
            aria-label="Search facilities" value="<%= (typeof searchQuery !== 'undefined' && searchQuery.city) ? searchQuery.city : '' %>">
          <button type="submit" class="search-button" aria-label="Search parking">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </form>

      <!-- Right Navigation Actions (ParkSphere Oval Buttons) -->
      <div class="navbar-right-actions ms-md-auto mt-3 mt-md-0">
        <% const user = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : (typeof locals !== 'undefined' && locals.currentUser ? locals.currentUser : null); %>
        <% if (!user) { %>
          <a class="nav-btn nav-btn-outline" href="/operator/dashboard">
            Operator Portal
          </a>

          <button type="button" class="nav-globe-btn align-self-center"
            title="Language & Region" aria-label="Choose language">
            <i class="fa-solid fa-globe"></i>
          </button>

          <a class="nav-btn nav-btn-outline" href="/login">
            Sign In
          </a>

          <a class="nav-btn nav-btn-primary" href="/register">
            Register
          </a>
        <% } else { %>
          <% if (user.role === 'OPERATOR' || user.role === 'ADMIN') { %>
            <a class="nav-btn nav-btn-outline" href="/operator/dashboard">
              Gate Console
            </a>
          <% } %>

          <a class="nav-btn nav-btn-outline" href="/customer/bookings">
            My Bookings
          </a>

          <a class="nav-btn nav-btn-outline" href="/customer/vehicles">
            Vehicles
          </a>

          <div class="user-badge d-none d-md-inline-flex" title="Active Account">
            <i class="fa-solid fa-circle-user text-dark"></i>
            <span><%= user.name || user.email %></span>
          </div>

          <a href="/logout" class="nav-btn nav-btn-primary text-decoration-none">
            Log Out
          </a>
        <% } %>
      </div>

    </div>
  </div>
</nav>
