<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card card-custom p-4 shadow text-center">
        <div class="mb-3">
          <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-3 mb-2">
            <i class="bi bi-shield-lock-fill"></i>
          </div>
          <h3 class="fw-bold">Verify Your Email</h3>
          <p class="text-muted small">
            We sent a 6-digit cryptographic verification code to <br>
            <strong class="text-white"><%= email %></strong>
          </p>
        </div>

        <form action="/verify-otp" method="POST">
          <input type="hidden" name="email" value="<%= email %>">

          <div class="mb-4">
            <input type="text" name="otp" class="form-control text-center fw-bold fs-3" maxlength="6" placeholder="000000" style="letter-spacing: 6px;" required autofocus>
            <div class="form-text text-muted small mt-2">Code expires in 10 minutes. (Check your terminal console during local development).</div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
            Verify & Activate Account
          </button>
        </form>

        <form action="/login" method="GET">
          <button type="submit" class="btn btn-link text-muted small text-decoration-none">
            Back to Sign In
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
