<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card p-4 border shadow-sm text-center" style="border-radius: 14px; background-color: #ffffff;">
        <div class="mb-3">
          <div class="d-inline-flex p-3 rounded-circle mb-2" style="background-color: var(--brand-emerald-light); color: var(--brand-emerald); font-size: 1.75rem;">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="fw-bold mb-1" style="color: var(--brand-slate);">Verify Your Email</h3>
          <p class="text-secondary small">
            We sent a 6-digit verification code to <br>
            <strong style="color: var(--brand-slate);"><%= email %></strong>
          </p>
        </div>

        <form action="/verify-otp" method="POST">
          <input type="hidden" name="email" value="<%= email %>">

          <div class="mb-4">
            <input type="text" name="otp" class="form-control text-center fw-bold fs-3" maxlength="6" placeholder="000000" style="letter-spacing: 6px; border-color: var(--brand-emerald) !important;" required autofocus>
            <div class="form-text text-secondary small mt-2">
              <i class="fa-regular fa-clock me-1"></i> Code expires in 10 minutes. (Check your terminal console during local development).
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3">
            <i class="fa-solid fa-check-circle me-1"></i> Verify & Activate Account
          </button>
        </form>

        <form action="/login" method="GET">
          <button type="submit" class="btn btn-link text-secondary small text-decoration-none">
            &larr; Back to Sign In
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
