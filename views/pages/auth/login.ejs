<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
        <div class="text-center mb-4">
          <div class="brand-icon mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
            <i class="fa-solid fa-square-parking"></i>
          </div>
          <h3 class="fw-bold mb-1" style="color: var(--brand-slate);">Sign In</h3>
          <p class="text-secondary small">Access your ParkSphere account</p>
        </div>

        <form action="/login" method="POST">
          <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="name@example.com" required autofocus>
          </div>

          <div class="mb-3">
            <label class="form-label mb-1">Password</label>
            <input type="password" name="password" class="form-control" placeholder="••••••••" required>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
          </button>

          <div class="text-center small text-secondary">
            Don't have an account? <a href="/register" class="fw-bold text-decoration-none" style="color: var(--brand-emerald);">Register</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
