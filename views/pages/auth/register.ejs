<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
        <div class="text-center mb-4">
          <div class="brand-icon mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
            <i class="fa-solid fa-square-parking"></i>
          </div>
          <h3 class="fw-bold mb-1" style="color: var(--brand-slate);">Create Account</h3>
          <p class="text-secondary small">Join ParkSphere for fast, verified parking access</p>
        </div>

        <form action="/register" method="POST">
          <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" name="name" class="form-control" placeholder="Alex Morgan" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="alex@example.com" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" placeholder="Minimum 6 characters" minlength="6" required>
          </div>

          <div class="mb-4">
            <label class="form-label">Account Role</label>
            <select name="role" class="form-select">
              <option value="CUSTOMER" selected>Customer (Find & Reserve Parking)</option>
              <option value="OPERATOR">Operator (Manage Parking Facilities)</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3">
            <i class="fa-solid fa-user-plus me-1"></i> Register & Send Verification OTP
          </button>

          <div class="text-center small text-secondary">
            Already have an account? <a href="/login" class="fw-bold text-decoration-none" style="color: var(--brand-emerald);">Sign In</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
