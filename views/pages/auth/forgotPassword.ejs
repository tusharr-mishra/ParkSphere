<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card card-custom p-4 shadow">
        <div class="text-center mb-4">
          <h3 class="fw-bold">Password Recovery</h3>
          <p class="text-muted small">Enter your email to receive a recovery code</p>
        </div>

        <form action="/forgot-password" method="POST">
          <div class="mb-4">
            <label class="form-label text-muted small fw-semibold">Registered Email</label>
            <input type="email" name="email" class="form-control" placeholder="name@example.com" required autofocus>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
            Send Reset Code
          </button>

          <div class="text-center small text-muted">
            Remember your password? <a href="/login" class="text-primary text-decoration-none fw-semibold">Sign In</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
