<% layout('layouts/boilerplate') %>

<!-- Hero Banner -->
<section class="hero-section text-center">
  <div class="container py-4">
    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill fw-semibold mb-3">
      <i class="bi bi-lightning-charge-fill me-1"></i> Real-Time Smart Parking Platform
    </span>
    
    <h1 class="display-4 fw-bold text-white mb-3">
      Reserve Your Parking Spot in <span class="text-primary">Seconds</span>
    </h1>
    
    <p class="lead text-muted mx-auto mb-4" style="max-width: 650px;">
      Frictionless parking discovery, guaranteed reservation bays, and authoritative digital check-in/out across premier metro facilities.
    </p>

    <!-- Search Box -->
    <div class="card card-custom p-3 mx-auto shadow-lg" style="max-width: 700px;">
      <form action="/parking" method="GET" class="row g-2 align-items-center">
        <div class="col-md-8">
          <div class="input-group">
            <span class="input-group-text bg-transparent border-0 text-primary fs-5">
              <i class="bi bi-geo-alt-fill"></i>
            </span>
            <input type="text" name="city" class="form-control" placeholder="Search by city (e.g. San Francisco, Seattle, Austin)...">
          </div>
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="bi bi-search me-1"></i> Find Parking
          </button>
        </div>
      </form>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 justify-content-center mt-5 text-center">
      <div class="col-6 col-md-3">
        <h3 class="fw-bold text-white mb-0">99.9%</h3>
        <p class="small text-muted mb-0">Conflict-Free Uptime</p>
      </div>
      <div class="col-6 col-md-3">
        <h3 class="fw-bold text-success mb-0">100%</h3>
        <p class="small text-muted mb-0">Zero Double-Booking</p>
      </div>
      <div class="col-6 col-md-3">
        <h3 class="fw-bold text-primary mb-0">&lt; 5s</h3>
        <p class="small text-muted mb-0">Instant Confirmation</p>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="py-5">
  <div class="container py-3">
    <div class="text-center mb-5">
      <h2 class="fw-bold">How ParkSphere Works</h2>
      <p class="text-muted">A clear, 4-step workflow designed for drivers and operators.</p>
    </div>

    <div class="row g-4">
      <div class="col-md-3">
        <div class="card card-custom h-100 p-4">
          <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-inline-flex p-3 mb-3 fs-4" style="width: fit-content;">
            <i class="bi bi-search"></i>
          </div>
          <h5 class="fw-bold">1. Find Facility</h5>
          <p class="text-muted small mb-0">Browse facilities by city, vehicle compatibility, hourly rates, and EV charging options.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card card-custom h-100 p-4">
          <div class="rounded-3 bg-success bg-opacity-10 text-success d-inline-flex p-3 mb-3 fs-4" style="width: fit-content;">
            <i class="bi bi-calendar-check"></i>
          </div>
          <h5 class="fw-bold">2. Reserve Slot</h5>
          <p class="text-muted small mb-0">Select an available bay with guaranteed conflict checks and obtain your digital booking code.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card card-custom h-100 p-4">
          <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-inline-flex p-3 mb-3 fs-4" style="width: fit-content;">
            <i class="bi bi-box-arrow-in-right"></i>
          </div>
          <h5 class="fw-bold">3. Check In</h5>
          <p class="text-muted small mb-0">Arrive at the facility, verify your booking, and park with authoritative entry timestamps.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card card-custom h-100 p-4">
          <div class="rounded-3 bg-info bg-opacity-10 text-info d-inline-flex p-3 mb-3 fs-4" style="width: fit-content;">
            <i class="bi bi-receipt"></i>
          </div>
          <h5 class="fw-bold">4. Checkout & Receipt</h5>
          <p class="text-muted small mb-0">Conclude your session with transparent server-computed fees and digital receipts.</p>
        </div>
      </div>
    </div>
  </div>
</section>
