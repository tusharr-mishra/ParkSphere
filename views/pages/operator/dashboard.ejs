<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Operator Console</h2>
      <p class="text-muted small mb-0">Live facility gate operations, active parked vehicles, and occupancy</p>
    </div>
    <a href="/operator/slots" class="btn btn-warning btn-sm px-3 fw-semibold">
      <i class="bi bi-grid-3x3-gap-fill me-1"></i> Slot Bay Controls
    </a>
  </div>

  <!-- Operational Metric Counters -->
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Assigned Facilities</span>
        <h2 class="fw-bold text-white mt-2 mb-0"><%= stats.totalFacilities %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Total Bays Managed</span>
        <h2 class="fw-bold text-primary mt-2 mb-0"><%= stats.totalSlots %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Active Parked Cars</span>
        <h2 class="fw-bold text-warning mt-2 mb-0"><%= stats.activeReservationsCount %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Today's Completed Stays</span>
        <h2 class="fw-bold text-success mt-2 mb-0"><%= stats.todayCompleted %></h2>
      </div>
    </div>
  </div>

  <!-- Gate Operations Desk -->
  <div class="card card-custom p-4 shadow">
    <h5 class="fw-bold text-white mb-3"><i class="bi bi-shield-check text-primary me-2"></i>Live Gate Desk (Incoming & Active Vehicles)</h5>

    <% if (activeBookings.length === 0) { %>
      <div class="text-center py-4 text-muted small">
        No active or incoming vehicle reservations currently.
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
          <thead>
            <tr class="text-muted small">
              <th>Booking Code</th>
              <th>Customer</th>
              <th>Facility</th>
              <th>Slot</th>
              <th>Plate / Vehicle</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% for (let b of activeBookings) { %>
              <tr>
                <td class="fw-bold text-primary"><%= b.bookingCode %></td>
                <td><%= b.user ? b.user.name : 'Customer' %></td>
                <td><%= b.facility ? b.facility.name : 'Facility' %></td>
                <td><span class="badge bg-secondary">Bay <%= b.slot ? b.slot.slotNumber : 'N/A' %></span></td>
                <td><strong><%= b.vehicle ? b.vehicle.registrationNumber : 'N/A' %></strong></td>
                <td>
                  <span class="badge badge-status <%= b.status === 'CONFIRMED' ? 'badge-confirmed' : 'badge-active' %>">
                    <%= b.status %>
                  </span>
                </td>
                <td>
                  <% if (b.status === 'CONFIRMED') { %>
                    <form action="/reservations/<%= b._id %>/check-in" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-success btn-sm py-1 px-2">
                        Gate Check In
                      </button>
                    </form>
                  <% } else if (b.status === 'ACTIVE') { %>
                    <form action="/reservations/<%= b._id %>/check-out" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-warning btn-sm py-1 px-2 fw-bold">
                        Gate Check Out
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
