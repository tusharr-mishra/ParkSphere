<% layout('layouts/boilerplate') %>

<div class="container py-5 text-center">
  <div class="card p-5 mx-auto border shadow-sm" style="max-width: 580px; border-radius: 16px; background-color: #ffffff;">
    <div class="mb-3 text-danger fs-1">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    
    <h2 class="fw-bold mb-2" style="color: var(--brand-slate);">
      <%= typeof statusCode !== 'undefined' ? statusCode : 500 %> - Error
    </h2>

    <p class="text-secondary mb-4">
      <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %>
    </p>

    <div class="d-flex justify-content-center gap-2">
      <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Go Back
      </a>
      <a href="/" class="btn btn-primary btn-sm px-3">
        <i class="fa-solid fa-house me-1"></i> Return Home
      </a>
    </div>
  </div>
</div>
