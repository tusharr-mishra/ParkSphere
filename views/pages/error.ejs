<% layout('layouts/boilerplate') %>

<div class="container py-5 text-center">
  <div class="card card-custom p-5 mx-auto shadow-lg" style="max-width: 580px;">
    <div class="mb-3 text-danger fs-1">
      <i class="bi bi-exclamation-octagon-fill"></i>
    </div>
    
    <h2 class="fw-bold mb-2 text-white">
      <%= typeof statusCode !== 'undefined' ? statusCode : 500 %> - Error
    </h2>

    <p class="text-muted mb-4">
      <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %>
    </p>

    <div class="d-flex justify-content-center gap-2">
      <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm px-3">
        <i class="bi bi-arrow-left me-1"></i> Go Back
      </a>
      <a href="/" class="btn btn-primary btn-sm px-3">
        <i class="bi bi-house-door-fill me-1"></i> Return Home
      </a>
    </div>
  </div>
</div>
