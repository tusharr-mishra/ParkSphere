<% layout('layouts/boilerplate') %>

<div class="listings-page-wrapper">

  <!-- Category Filter Slider & Display Taxes Toggle (ParkSphere Style) -->
  <div class="filter-bar-container">
    <div class="filter-slider-wrap">
      <button type="button" class="filter-arrow" id="filterLeft" aria-label="Scroll categories left">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div id="filters">
        <% 
        const categoryList = [
          { name: "Popular", icon: "fa-fire" },
          { name: "Downtown Hubs", icon: "fa-city" },
          { name: "Airport Parking", icon: "fa-plane-departure" },
          { name: "EV Charging", icon: "fa-bolt" },
          { name: "Covered Garages", icon: "fa-warehouse" },
          { name: "Valet Bays", icon: "fa-key" },
          { name: "24/7 Access", icon: "fa-clock" },
          { name: "SUV / Trucks", icon: "fa-truck-pickup" },
          { name: "CCTV Secured", icon: "fa-shield-halved" },
          { name: "Underground", icon: "fa-arrow-down-up-across-line" },
          { name: "Motorcycle", icon: "fa-motorcycle" },
          { name: "Budget Bays", icon: "fa-wallet" },
          { name: "Events & Arenas", icon: "fa-ticket" },
          { name: "Overnight Stays", icon: "fa-moon" }
        ];
        const activeCat = (typeof category !== 'undefined' && category) ? category : 'Popular';
        const cityParam = (typeof searchQuery !== 'undefined' && searchQuery.city) ? searchQuery.city : '';
        %>

        <% for (let cat of categoryList) { %>
          <% 
          const isSelected = (activeCat === cat.name);
          const href = (cat.name === 'Popular')
            ? `/parking${cityParam ? `?city=${encodeURIComponent(cityParam)}` : ''}`
            : `/parking?category=${encodeURIComponent(cat.name)}${cityParam ? `&city=${encodeURIComponent(cityParam)}` : ''}`;
          %>
          <a href="<%= href %>" class="filter <%= isSelected ? 'active' : '' %>" aria-label="Filter by <%= cat.name %>">
            <i class="fa-solid <%= cat.icon %>"></i>
            <p><%= cat.name %></p>
          </a>
        <% } %>
      </div>

      <button type="button" class="filter-arrow" id="filterRight" aria-label="Scroll categories right">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <!-- Display Total with Taxes Toggle Switch -->
    <div class="tax-toggle-box" id="taxToggleBox">
      <div class="tax-text-group">
        <span class="tax-main-label">Display total before taxes</span>
        <span class="tax-sub-label">Includes estimated taxes & fees</span>
      </div>
      <div class="form-check form-switch m-0">
        <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch" aria-label="Display prices including municipal taxes">
      </div>
    </div>
  </div>

  <!-- Fallback Banner When No Facilities Match Filters -->
  <% if (facilities.length === 0) { %>
    <div class="search-fallback-banner">
      <div class="fallback-icon-wrap">
        <i class="fa-solid fa-compass"></i>
      </div>
      <div class="fallback-text-wrap">
        <h4 class="mb-1">No parking locations found matching "<%= cityParam || activeCat %>"</h4>
        <p class="mb-0 text-secondary">Explore all verified smart parking facilities across premier metro areas, or try another city search.</p>
        <div class="mt-3">
          <a href="/parking" class="nav-btn nav-btn-primary">View All Facilities</a>
        </div>
      </div>
    </div>
  <% } else { %>
    <!-- Edge-to-Edge Responsive Parking Grid (ParkSphere Grid) -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-4 row-cols-xxl-5 g-4 listings-grid">
      <% for (let facility of facilities) { %>
        <div class="col">
          <a href="/parking/<%= facility._id %>" class="listing-card-link">
            <div class="listing-card">
              <!-- Image with Rounded Corners & Parking Status Badge -->
              <div class="listing-image-wrapper">
                <img src="<%= facility.image %>" class="listing-card-img" alt="<%= facility.name %>" loading="lazy">
                <% if (facility.amenities && facility.amenities.includes('EV_CHARGING')) { %>
                  <span class="slot-feature-badge"><i class="fa-solid fa-bolt text-warning me-1"></i> EV Ready</span>
                <% } else if (facility.amenities && facility.amenities.includes('VALET')) { %>
                  <span class="slot-feature-badge"><i class="fa-solid fa-key me-1"></i> Valet Available</span>
                <% } else if (facility.amenities && facility.amenities.includes('COVERED')) { %>
                  <span class="slot-feature-badge"><i class="fa-solid fa-warehouse me-1"></i> Covered Bay</span>
                <% } else { %>
                  <span class="slot-feature-badge"><i class="fa-solid fa-shield-halved me-1"></i> Instant Gate</span>
                <% } %>
                <button type="button" class="listing-heart-btn" aria-label="Save to favourites"
                  onclick="event.preventDefault(); const i = this.querySelector('i'); i.classList.toggle('fa-solid'); i.classList.toggle('fa-regular'); i.classList.toggle('text-danger');">
                  <i class="fa-regular fa-heart"></i>
                </button>
              </div>

              <!-- Card Content Information -->
              <div class="listing-card-body">
                <div class="listing-header-row">
                  <h3 class="listing-card-title"><%= facility.name %></h3>
                  <span class="listing-rating-badge">
                    <i class="fa-solid fa-star text-warning"></i> 4.9
                  </span>
                </div>

                <p class="listing-card-location"><%= facility.address %>, <%= facility.city %></p>
                <p class="listing-card-meta"><%= facility.totalSlots %> bays open • Live Gate Entry</p>

                <div class="listing-price-row">
                  <% const symMap = { INR: '₹', USD: '$', GBP: '£', EUR: '€', AED: 'AED', SGD: 'S$', JPY: '¥', AUD: 'A$' }; %>
                  <span class="listing-price-val listing-price"
                    data-base-price="<%= facility.pricing.hourlyRate %>"
                    data-currency-symbol="<%= symMap[facility.currency] || '$' %>"
                    data-tax-rate="0.12">
                    <%= formatPrice(facility.pricing.hourlyRate, facility.currency) %>
                  </span>
                  <span class="text-secondary"> hour</span>
                </div>

                <span class="tax-included-label" hidden>Includes 12% municipal taxes & fees</span>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

</div>

<script src="/js/listings.js"></script>
