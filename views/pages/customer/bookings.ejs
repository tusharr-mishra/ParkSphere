<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">My Parking Reservations</h2>
      <p class="text-muted small mb-0">Track live parking sessions, check-in, check-out, and view digital receipts</p>
    </div>
    <a href="/parking" class="btn btn-primary btn-sm px-3">
      <i class="bi bi-search me-1"></i> Book New Bay
    </a>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="card card-custom p-5 text-center my-4">
      <div class="mb-3 text-muted fs-1"><i class="bi bi-calendar-x"></i></div>
      <h4 class="fw-bold">No Bookings Found</h4>
      <p class="text-muted small">You don't have any parking reservations yet.</p>
      <div>
        <a href="/parking" class="btn btn-primary btn-sm">Browse Facilities</a>
      </div>
    </div>
  <% } else { %>
    <div class="d-flex flex-column gap-3">
      <% for (let b of bookings) { %>
        <div class="card card-custom p-4 shadow-sm">
          <div class="row align-items-center g-3">
            <!-- Left Info -->
            <div class="col-md-4">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="fs-5 fw-bold text-primary"><%= b.bookingCode %></span>
                <span class="badge badge-status <%= b.status === 'CONFIRMED' ? 'badge-confirmed' : b.status === 'ACTIVE' ? 'badge-active' : b.status === 'COMPLETED' ? 'badge-completed' : 'badge-cancelled' %>">
                  <%= b.status %>
                </span>
              </div>
              <h5 class="fw-bold text-white mb-1"><%= b.facility ? b.facility.name : 'Parking Facility' %></h5>
              <div class="text-muted small"><%= b.facility ? b.facility.address + ', ' + b.facility.city : '' %></div>
            </div>

            <!-- Center Bay / Vehicle Info -->
            <div class="col-md-4">
              <div class="small text-muted mb-1">
                <i class="bi bi-p-square-fill text-primary me-1"></i>
                Slot: <strong class="text-white"><%= b.slot ? b.slot.slotNumber : 'N/A' %></strong> (<%= b.slot ? b.slot.slotType : '' %>)
              </div>
              <div class="small text-muted mb-1">
                <i class="bi bi-car-front-fill text-warning me-1"></i>
                Vehicle: <strong class="text-white"><%= b.vehicle ? b.vehicle.registrationNumber : 'N/A' %></strong>
              </div>
              <div class="small text-muted">
                <i class="bi bi-clock-fill text-info me-1"></i>
                Window: <%= new Date(b.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %> - <%= new Date(b.endTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
              </div>
            </div>

            <!-- Right Pricing & Actions -->
            <div class="col-md-4 text-md-end">
              <div class="mb-2">
                <span class="small text-muted">Authorized Amount: </span>
                <span class="fs-5 fw-bold text-white">$<%= b.finalAmount ? b.finalAmount.toFixed(2) : b.estimatedAmount.toFixed(2) %></span>
              </div>

              <div class="d-flex justify-content-md-end gap-2 flex-wrap">
                <!-- Check-in Action (Only when CONFIRMED) -->
                <% if (b.status === 'CONFIRMED') { %>
                  <form action="/reservations/<%= b._id %>/check-in" method="POST">
                    <button type="submit" class="btn btn-success btn-sm px-3">
                      <i class="bi bi-box-arrow-in-right me-1"></i> Check In
                    </button>
                  </form>
                  <form action="/reservations/<%= b._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation?')">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                      Cancel
                    </button>
                  </form>
                <% } %>

                <!-- Check-out Action (Only when ACTIVE) -->
                <% if (b.status === 'ACTIVE') { %>
                  <form action="/reservations/<%= b._id %>/check-out" method="POST">
                    <button type="submit" class="btn btn-warning btn-sm px-3 fw-bold">
                      <i class="bi bi-box-arrow-right me-1"></i> Check Out
                    </button>
                  </form>
                <% } %>

                <% if (b.status === 'COMPLETED') { %>
                  <span class="text-success small fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> Session Completed</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
