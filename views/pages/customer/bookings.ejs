<% layout('layouts/boilerplate') %>

<%
  const allCount = bookings.length;
  const confirmedCount = bookings.filter(b => b.status === 'CONFIRMED').length;
  const activeCount = bookings.filter(b => b.status === 'ACTIVE').length;
  const completedCount = bookings.filter(b => b.status === 'COMPLETED').length;
  const cancelledCount = bookings.filter(b => b.status === 'CANCELLED').length;
%>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1" style="color: var(--brand-slate);">My Parking Reservations</h2>
      <p class="text-secondary small mb-0">Track live parking sessions, check in/out, and access digital transaction receipts</p>
    </div>
    <a href="/parking" class="btn btn-primary btn-sm px-3">
      <i class="fa-solid fa-magnifying-glass me-1"></i> Book New Bay
    </a>
  </div>

  <!-- Filter Status Tabs (ParkSphere Session Filters) -->
  <div class="d-flex gap-2 mb-4 flex-wrap" id="statusFilterTabs">
    <button type="button" class="btn btn-sm btn-brand-primary filter-tab active" onclick="filterBookings('ALL', this)">
      All Trips (<%= allCount %>)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary filter-tab" onclick="filterBookings('CONFIRMED', this)">
      <i class="fa-solid fa-circle-check text-success me-1"></i> Confirmed (<%= confirmedCount %>)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary filter-tab" onclick="filterBookings('ACTIVE', this)">
      <i class="fa-solid fa-bolt text-primary me-1"></i> Active (<%= activeCount %>)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary filter-tab" onclick="filterBookings('COMPLETED', this)">
      <i class="fa-solid fa-flag-checkered text-secondary me-1"></i> Completed (<%= completedCount %>)
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary filter-tab" onclick="filterBookings('CANCELLED', this)">
      <i class="fa-solid fa-ban text-danger me-1"></i> Cancelled (<%= cancelledCount %>)
    </button>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="card p-5 text-center my-4 border-0 shadow-sm" style="border-radius: 16px; background-color: #ffffff;">
      <div class="mb-3 fs-1 text-secondary"><i class="fa-solid fa-calendar-xmark"></i></div>
      <h4 class="fw-bold mb-2" style="color: var(--brand-slate);">No Bookings Found</h4>
      <p class="text-secondary small mb-4">You do not have any parking reservations recorded yet. Browse facilities and secure your first bay!</p>
      <div>
        <a href="/parking" class="btn btn-primary btn-sm px-4">Browse Locations</a>
      </div>
    </div>
  <% } else { %>
    <div class="d-flex flex-column gap-3" id="bookingsList">
      <% for (let b of bookings) { %>
        <div class="card p-4 border shadow-sm booking-card" data-status="<%= b.status %>" style="border-radius: 14px; background-color: #ffffff;">
          <div class="row align-items-center g-3">
            <!-- Left Info -->
            <div class="col-md-4">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="fs-5 fw-bold" style="color: var(--brand-emerald);"><%= b.bookingCode %></span>
                <span class="badge badge-status <%= b.status === 'CONFIRMED' ? 'badge-confirmed' : b.status === 'ACTIVE' ? 'badge-active' : b.status === 'COMPLETED' ? 'badge-completed' : 'badge-cancelled' %>">
                  <%= b.status %>
                </span>
              </div>
              <h5 class="fw-bold mb-1" style="color: var(--brand-slate);"><%= b.facility ? b.facility.name : 'Parking Facility' %></h5>
              <div class="text-secondary small">
                <i class="fa-solid fa-location-dot text-danger me-1"></i><%= b.facility ? b.facility.address + ', ' + b.facility.city : '' %>
              </div>
            </div>

            <!-- Center Bay / Vehicle Info -->
            <div class="col-md-4">
              <div class="small text-secondary mb-1">
                <i class="fa-solid fa-square-parking text-success me-1"></i>
                Slot: <strong style="color: var(--brand-slate);"><%= b.slot ? b.slot.slotNumber : 'N/A' %></strong> (<%= b.slot ? b.slot.slotType : '' %>)
              </div>
              <div class="small text-secondary mb-1">
                <i class="fa-solid fa-car text-primary me-1"></i>
                Vehicle: <strong style="color: var(--brand-slate);"><%= b.vehicle ? b.vehicle.registrationNumber : 'N/A' %></strong>
              </div>
              <div class="small text-secondary">
                <i class="fa-regular fa-clock me-1"></i>
                Window: <%= new Date(b.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %> - <%= new Date(b.endTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
              </div>
            </div>

            <!-- Right Pricing & Actions -->
            <div class="col-md-4 text-md-end">
              <div class="mb-2">
                <span class="small text-secondary">Total Fee: </span>
                <span class="fs-5 fw-bold" style="color: var(--brand-slate);">$<%= b.finalAmount ? b.finalAmount.toFixed(2) : b.estimatedAmount.toFixed(2) %></span>
              </div>

              <div class="d-flex justify-content-md-end gap-2 flex-wrap">
                <!-- Check-in Action (Only when CONFIRMED) -->
                <% if (b.status === 'CONFIRMED') { %>
                  <form action="/reservations/<%= b._id %>/check-in" method="POST">
                    <button type="submit" class="btn btn-success btn-sm px-3 fw-bold">
                      <i class="fa-solid fa-right-to-bracket me-1"></i> Gate Check In
                    </button>
                  </form>
                  <form action="/reservations/<%= b._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation?')">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                      Cancel
                    </button>
                  </form>
                <% } %>

                <!-- Check-out Action (Only when ACTIVE) -->
                <% if (b.status === 'ACTIVE') { %>
                  <form action="/reservations/<%= b._id %>/check-out" method="POST">
                    <button type="submit" class="btn btn-warning btn-sm px-3 fw-bold text-dark">
                      <i class="fa-solid fa-right-from-bracket me-1"></i> Gate Check Out
                    </button>
                  </form>
                <% } %>

                <% if (b.status === 'COMPLETED') { %>
                  <span class="text-success small fw-semibold">
                    <i class="fa-solid fa-circle-check me-1"></i> Session Completed
                  </span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<script>
  function filterBookings(status, btn) {
    // Update active tab styles
    document.querySelectorAll('.filter-tab').forEach(b => {
      b.className = 'btn btn-sm btn-outline-secondary filter-tab';
    });
    btn.className = 'btn btn-sm btn-brand-primary filter-tab active';

    // Show/hide cards
    const cards = document.querySelectorAll('.booking-card');
    cards.forEach(card => {
      if (status === 'ALL' || card.dataset.status === status) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>
