<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Customer Dashboard</h2>
      <p class="text-muted small mb-0">Manage your active reservations, parking history, and vehicles</p>
    </div>
    <a href="/parking" class="btn btn-primary btn-sm px-3">
      <i class="bi bi-search me-1"></i> Book New Bay
    </a>
  </div>

  <!-- Metric Counters -->
  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Active Bookings</span>
        <h2 class="fw-bold text-success mt-2 mb-0"><%= stats.activeBookingsCount %></h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Total Completed Stays</span>
        <h2 class="fw-bold text-white mt-2 mb-0"><%= stats.totalCompleted %></h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Registered Vehicles</span>
        <h2 class="fw-bold text-primary mt-2 mb-0"><%= stats.vehiclesCount %></h2>
      </div>
    </div>
  </div>

  <!-- Recent Bookings Table -->
  <div class="card card-custom p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0 text-white">Recent Reservations</h5>
      <a href="/customer/bookings" class="small text-primary text-decoration-none">View All &rarr;</a>
    </div>

    <% if (recentBookings.length === 0) { %>
      <div class="text-center py-4 text-muted small">
        No reservations recorded yet. Browse facilities and book your first spot!
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
          <thead>
            <tr class="text-muted small">
              <th>Booking Code</th>
              <th>Facility</th>
              <th>Slot</th>
              <th>Vehicle</th>
              <th>Status</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            <% for (let b of recentBookings) { %>
              <tr>
                <td class="fw-bold text-primary"><%= b.bookingCode %></td>
                <td><%= b.facility ? b.facility.name : 'Facility' %></td>
                <td><%= b.slot ? b.slot.slotNumber : 'N/A' %></td>
                <td><%= b.vehicle ? b.vehicle.registrationNumber : 'N/A' %></td>
                <td>
                  <span class="badge badge-status <%= b.status === 'CONFIRMED' ? 'badge-confirmed' : b.status === 'ACTIVE' ? 'badge-active' : b.status === 'COMPLETED' ? 'badge-completed' : 'badge-cancelled' %>">
                    <%= b.status %>
                  </span>
                </td>
                <td class="fw-semibold text-white">$<%= b.finalAmount ? b.finalAmount.toFixed(2) : b.estimatedAmount.toFixed(2) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
