<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1" style="color: var(--brand-slate);">My Registered Vehicles</h2>
      <p class="text-secondary small mb-0">Register license plates and EV compatibility to enable 1-click bay booking</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Add Vehicle Form Column -->
    <div class="col-lg-4">
      <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
        <h5 class="fw-bold mb-3" style="color: var(--brand-slate);">
          <i class="fa-solid fa-circle-plus text-success me-2"></i>Register Vehicle
        </h5>

        <form action="/customer/vehicles" method="POST">
          <div class="mb-3">
            <label class="form-label">License Plate / Registration</label>
            <input type="text" name="registrationNumber" class="form-control" placeholder="e.g. 7XYZ890" style="text-transform: uppercase;" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Vehicle Type</label>
            <select name="vehicleType" class="form-select">
              <option value="SEDAN" selected>Sedan</option>
              <option value="COMPACT">Compact / Hatchback</option>
              <option value="SUV">SUV / Truck</option>
              <option value="TWO_WHEELER">Two Wheeler / Motorcycle</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Make & Model</label>
            <div class="row g-2">
              <div class="col-6">
                <input type="text" name="make" class="form-control" placeholder="Tesla / Toyota">
              </div>
              <div class="col-6">
                <input type="text" name="model" class="form-control" placeholder="Model 3 / RAV4">
              </div>
            </div>
          </div>

          <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" name="isEV" id="evSwitch">
            <label class="form-check-label text-secondary small" for="evSwitch">Electric Vehicle (EV) Compatible</label>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
            <i class="fa-solid fa-floppy-disk me-1"></i> Save Vehicle
          </button>
        </form>
      </div>
    </div>

    <!-- Vehicles List Column -->
    <div class="col-lg-8">
      <% if (vehicles.length === 0) { %>
        <div class="card p-5 text-center border-0 shadow-sm" style="border-radius: 16px; background-color: #ffffff;">
          <div class="mb-3 fs-1 text-secondary"><i class="fa-solid fa-car-side"></i></div>
          <h5 class="fw-bold" style="color: var(--brand-slate);">No Vehicles Registered</h5>
          <p class="text-secondary small">Register your vehicle on the left to start reserving parking bays across facilities.</p>
        </div>
      <% } else { %>
        <div class="row g-3">
          <% for (let v of vehicles) { %>
            <div class="col-md-6">
              <div class="card p-4 h-100 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="fs-4 fw-bold" style="color: var(--brand-slate);"><%= v.registrationNumber %></span>
                  <% if (v.isEV) { %>
                    <span class="badge" style="background-color: var(--brand-emerald-light); color: var(--brand-emerald); border: 1px solid var(--brand-emerald-border);">
                      <i class="fa-solid fa-bolt me-1"></i> EV
                    </span>
                  <% } %>
                </div>

                <div class="text-secondary small mb-3">
                  <%= v.make %> <%= v.model %> • <%= v.vehicleType %>
                </div>

                <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: #e2e8f0 !important;">
                  <span class="badge" style="background-color: #f1f5f9; color: #475569;">
                    <i class="fa-solid fa-circle-check text-success me-1"></i> Verified Active
                  </span>
                  <form action="/customer/vehicles/<%= v._id %>/delete" method="POST" onsubmit="return confirm('Remove vehicle?')">
                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove Vehicle">
                      <i class="fa-regular fa-trash-can"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
