<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">System Governance & Telemetry</h2>
      <p class="text-muted small mb-0">Platform overview, user accounts, and immutable audit trails</p>
    </div>
    <a href="/admin/audit-logs" class="btn btn-info btn-sm px-3 fw-semibold">
      <i class="bi bi-file-earmark-text-fill me-1"></i> Audit Log Trail
    </a>
  </div>

  <!-- Platform Telemetry Metrics -->
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Total Users</span>
        <h2 class="fw-bold text-white mt-2 mb-0"><%= stats.totalUsers %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Active Facilities</span>
        <h2 class="fw-bold text-primary mt-2 mb-0"><%= stats.totalFacilities %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Platform Bookings</span>
        <h2 class="fw-bold text-warning mt-2 mb-0"><%= stats.totalReservations %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card card-custom p-4">
        <span class="text-muted small fw-semibold text-uppercase">Gross Revenue</span>
        <h2 class="fw-bold text-success mt-2 mb-0">$<%= stats.totalRevenue.toFixed(2) %></h2>
      </div>
    </div>
  </div>

  <!-- Users Directory Table -->
  <div class="card card-custom p-4 shadow">
    <h5 class="fw-bold text-white mb-3"><i class="bi bi-people-fill text-primary me-2"></i>Recent Users Directory</h5>

    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
        <thead>
          <tr class="text-muted small">
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Email Verified</th>
            <th>Registered At</th>
          </tr>
        </thead>
        <tbody>
          <% for (let u of recentUsers) { %>
            <tr>
              <td class="fw-bold text-white"><%= u.name %></td>
              <td><%= u.email %></td>
              <td>
                <span class="badge <%= u.role === 'ADMIN' ? 'bg-danger' : u.role === 'OPERATOR' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                  <%= u.role %>
                </span>
              </td>
              <td>
                <% if (u.isEmailVerified) { %>
                  <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Verified</span>
                <% } else { %>
                  <span class="badge bg-secondary">Unverified</span>
                <% } %>
              </td>
              <td class="small text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
