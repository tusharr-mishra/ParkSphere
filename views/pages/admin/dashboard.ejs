<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1" style="color: var(--brand-slate);">System Governance & Telemetry</h2>
      <p class="text-secondary small mb-0">Platform overview, user accounts, and immutable system audit logs</p>
    </div>
    <a href="/admin/audit-logs" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
      <i class="fa-solid fa-file-shield me-1"></i> Audit Log Trail
    </a>
  </div>

  <!-- Platform Telemetry Metrics -->
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
        <span class="text-secondary small fw-semibold text-uppercase">Total Users</span>
        <h2 class="fw-bold mt-2 mb-0" style="color: var(--brand-slate);"><%= stats.totalUsers %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
        <span class="text-secondary small fw-semibold text-uppercase">Active Facilities</span>
        <h2 class="fw-bold mt-2 mb-0" style="color: var(--brand-blue);"><%= stats.totalFacilities %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
        <span class="text-secondary small fw-semibold text-uppercase">Platform Bookings</span>
        <h2 class="fw-bold mt-2 mb-0" style="color: #d97706;"><%= stats.totalReservations %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
        <span class="text-secondary small fw-semibold text-uppercase">Gross Revenue</span>
        <h2 class="fw-bold mt-2 mb-0" style="color: var(--brand-emerald);">$<%= stats.totalRevenue.toFixed(2) %></h2>
      </div>
    </div>
  </div>

  <!-- Users Directory Table -->
  <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
    <h5 class="fw-bold mb-3" style="color: var(--brand-slate);">
      <i class="fa-solid fa-users text-primary me-2"></i>Recent Users Directory
    </h5>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="text-secondary small text-uppercase">
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Email Verified</th>
            <th>Registered At</th>
          </tr>
        </thead>
        <tbody>
          <% for (let u of recentUsers) { %>
            <tr>
              <td class="fw-bold" style="color: var(--brand-slate);"><%= u.name %></td>
              <td><%= u.email %></td>
              <td>
                <span class="badge <%= u.role === 'ADMIN' ? 'bg-danger' : u.role === 'OPERATOR' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                  <%= u.role %>
                </span>
              </td>
              <td>
                <% if (u.isEmailVerified) { %>
                  <span class="badge" style="background-color: var(--brand-emerald-light); color: var(--brand-emerald); border: 1px solid var(--brand-emerald-border);">
                    <i class="fa-solid fa-circle-check me-1"></i> Verified
                  </span>
                <% } else { %>
                  <span class="badge bg-secondary">Unverified</span>
                <% } %>
              </td>
              <td class="small text-secondary"><%= new Date(u.createdAt).toLocaleDateString() %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
