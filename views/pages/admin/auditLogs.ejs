<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1" style="color: var(--brand-slate);">Security & Action Audit Log</h2>
      <p class="text-secondary small mb-0">Immutable records of critical user, operator, and administrative mutations</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-chevron-left me-1"></i> Back to Admin Dashboard
    </a>
  </div>

  <div class="card p-4 border shadow-sm" style="border-radius: 14px; background-color: #ffffff;">
    <% if (logs.length === 0) { %>
      <div class="text-center py-4 text-secondary small">
        No audit log records recorded yet.
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr class="text-secondary small text-uppercase">
              <th>Timestamp</th>
              <th>Action</th>
              <th>Actor</th>
              <th>Entity</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% for (let log of logs) { %>
              <tr>
                <td class="small text-secondary"><%= new Date(log.timestamp).toLocaleString() %></td>
                <td>
                  <span class="badge" style="background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">
                    <%= log.action %>
                  </span>
                </td>
                <td>
                  <strong><%= log.actor ? log.actor.name : 'System' %></strong>
                  <span class="text-secondary small">(<%= log.actor ? log.actor.role : 'CRON' %>)</span>
                </td>
                <td>
                  <span class="text-secondary small"><%= log.entityType %>: <%= log.entityId.slice(-6) %></span>
                </td>
                <td>
                  <code class="p-1 rounded small" style="background-color: #f1f5f9; color: #0f172a;"><%= JSON.stringify(log.metadata) %></code>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
