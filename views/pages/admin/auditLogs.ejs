<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Security & Action Audit Log</h2>
      <p class="text-muted small mb-0">Immutable records of critical user, operator, and administrative mutations</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">
      &larr; Back to Admin Dashboard
    </a>
  </div>

  <div class="card card-custom p-4 shadow">
    <% if (logs.length === 0) { %>
      <div class="text-center py-4 text-muted small">
        No audit log records recorded yet.
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
          <thead>
            <tr class="text-muted small">
              <th>Timestamp</th>
              <th>Action</th>
              <th>Actor</th>
              <th>Entity</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% for (let log of logs) { %>
              <tr>
                <td class="small text-muted"><%= new Date(log.timestamp).toLocaleString() %></td>
                <td>
                  <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25">
                    <%= log.action %>
                  </span>
                </td>
                <td>
                  <%= log.actor ? log.actor.name + ' (' + log.actor.role + ')' : 'System' %>
                </td>
                <td>
                  <span class="text-muted small"><%= log.entityType %>: <%= log.entityId.slice(-6) %></span>
                </td>
                <td>
                  <code class="text-warning small"><%= JSON.stringify(log.metadata) %></code>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
